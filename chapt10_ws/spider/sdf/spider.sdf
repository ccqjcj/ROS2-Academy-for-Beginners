    <joint name='l1leg1j' type='revolute'>
      <pose>0 0 0 0 0 0</pose>
      <parent>body</parent>
      <child>l1leg1</child>
      <axis>
      	<xyz>0 0 1</xyz> 
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>200</effort>    <!--force ?-->
          <velocity>1</velocity>  <!--set joint max speed radians-->
          <stiffness>1000000</stiffness>
          <dissipaton>1000</dissipaton>
        </limit>
        <dynamics>
          <damping>0.8</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
