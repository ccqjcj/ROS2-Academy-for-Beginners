      <xyz>0 1 0</xyz> <!-- The xyz unit vector is expressed in the joint frame -->
      <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>200</effort>    <!--force ?-->
          <velocity>1</velocity>  <!--set joint max speed radians-->
