<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="spiderbot" canonical_link="body">
    <link name="body">
        <self_collide>true</self_collide>
        <inertial> 
          <inertia>
            <ixx>0.2</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.2</iyy>
            <iyz>0</iyz>
